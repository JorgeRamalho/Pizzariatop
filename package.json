{
  "name": "pizzaria-top",
  "version": "1.0.0",
  "description": "Site delivery Pizzaria Top",
  "private": true,
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "serve": "npx --yes serve . -p 3000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "fonts:sync": "node scripts/sync-fonts.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.26.1"
  }
}
